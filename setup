set -o pipefail
killall apt apt-get &> /dev/null
export DEBIAN_FRONTEND=noninteractive
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games/
front_file_local='/bin/ejecutar/msg'
ENLACES=(
"https://raw.githubusercontent.com/ChumoGH/ADMcgh/main/Plugins/system/styles.cpp"
"https://www.dropbox.com/scl/fi/je70qpfmwu6416ail48zq/msg?rlkey=jg8eazt0p95pkq0xj4ckrrt1y"
"https://plus.admcgh.site/ChumoGH/msg"
)
SERVIDORES=(
"GitHUB"
"DropBox"
"ChumoGH SIte"
)
mkdir -p /bin/ejecutar
descargar() {
local indice=$1
if [[ -s "$front_file_local" ]]; then
echo "✅ Archivo ya existe en $front_file_local"
return 0
fi
if [[ $indice -ge ${#ENLACES[@]} ]]; then
echo "❌ No se pudo descargar el archivo desde ninguno de los enlaces."
return 1
fi
local url=${ENLACES[$indice]}
local servidor=${SERVIDORES[$indice]}
echo -ne "🔄 Intentando descargar desde: $servidor"
if wget -q --no-check-certificate -t3 -T3 -O "$front_file_local" "$url"; then
echo "✅ "
chmod +x ${front_file_local}
source ${front_file_local}
return 0
else
echo -e "⚠️ /n $servidor Fallo. Reintentando con otro...\n"
descargar $((indice+1))
fi
}
if [[ ! -s "$front_file_local" ]]; then
descargar 0
else
chmod +x ${front_file_local}
source ${front_file_local}
fi

SCPdir="/etc/adm-lite"
SCPinstal="$HOME/install"

fun_ip(){
MIP=$(ip addr | grep 'inet' | grep -v inet6 | grep -vE '127\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' | grep -o -E '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' | head -1)
MIP2=$(wget -qO- --no-cache --no-check-certificate --max-redirect=20  ipv4.icanhazip.com)
[[ "$MIP" != "$MIP2" ]] && IP="$MIP2" || IP="$MIP"
mkdir -p /bin/ejecutar
echo $IP > /bin/ejecutar/IPcgh
echo $IP
}

TIME_START="$(date +%s)"
[[ -e $HOME/cgh.sh ]] && rm $HOME/cgh.*

if ! [ $(id -u) = 0 ]; then
clear
echo ""
echo " ===================================================="
echo "                  Error Fatal!! x000e1 "
echo " ===================================================="
echo "                    Este script debe ejecutarse como root! "
echo "                              Como Solucionarlo "
echo "                            Ejecute el script así:"
echo "                                ( sudo -i )"
echo "                                   sudo su"
echo "                                 Retornando . . ."
echo $(date)
exit
fi

# Descarga directa del paquete de archivos del menú sin pedir key
instalar_libre() {
clear
echo -e "\033[1;33m Descargando archivos del menú...\033[0m"
mkdir -p ${SCPdir}
mkdir -p ${SCPinstal}
wget -q --no-cache --no-check-certificate https://raw.githubusercontent.com/ChumoGH/ADMcgh/main/Plugins/system/pack3.tar -O /tmp/pack3.tar
if [[ -f /tmp/pack3.tar ]]; then
tar -xf /tmp/pack3.tar -C ${SCPdir} &>/dev/null || tar -xf /tmp/pack3.tar -C ${SCPinstal} &>/dev/null
cp -rf ${SCPinstal}/* ${SCPdir}/ &>/dev/null
chmod +x ${SCPdir}/* &>/dev/null
fi
# Creamos enlaces simbólicos o aseguramos el comando menu
if [[ -f ${SCPdir}/menu ]]; then
ln -sf ${SCPdir}/menu /usr/bin/menu
chmod +x /usr/bin/menu
fi
rm -rf /tmp/pack3.tar
}

instalar_libre

countdown() {
local seconds="$1"
while [ "$seconds" -gt 0 ]; do
echo -ne "\r REINICIANDO EN : $seconds seconds    "
sleep 1
seconds=$((seconds - 1))
done
echo -e "\rRESTART complete!         "
sudo reboot
}

clear&&clear
echo -e " TIEMPO DE EJECUCION $((($(date +%s)-$TIME_START)/60)) min."
msg -bar3
echo -e " ¡INSTALACIÓN COMPLETADA CON ÉXITO!"
echo -e " Escribe \033[1;32mmenu\033[0m para abrir la interfaz."
msg -bar3

read -p " $( echo -e "PRESIONA ENTER PARA FINALIZAR Y ABRIR EL MENÚ \n $(msg -bar3)")"
[[ -e "$(which menu)" ]] && menu || bash <(echo "menu")
exit
