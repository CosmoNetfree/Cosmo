_sleepColor(){
local time=$1
local accion=$2
[[ -z ${accion} ]] && sleep ${time:-2s} || ${accion} &>/dev/null
}

rm -f instala.*
[[ -e /etc/folteto ]] && rm -f /etc/folteto
[[ -e /bin/ejecutar/IPcgh ]] && rm -f /bin/ejecutar/IPcgh

{
    rm -f wget*
    [[ $(dpkg --get-selections|grep -w "curl"|head -1) ]] || apt-get -qq install curl -y &> /dev/null
    _double=$(wget -q -T 5 -O - "https://raw.githubusercontent.com/ChumoGH/ADMcgh/refs/heads/main/TOKENS/dinamicos/control")
    COLS=$(tput cols)
    os_system(){
    system=$(cat -n /etc/issue |grep 1 |cut -d ' ' -f6,7,8 |sed 's/1//' |sed 's/      //')
    distro=$(echo "$system"|awk '{print $1}')
    case $distro in
    Debian)vercion=$(echo $system|awk '{print $3}'|cut -d '.' -f1);;
    Ubuntu)vercion=$(echo $system|awk '{print $2}'|cut -d '.' -f1,2);;
    esac
    }
    
    fun_install () {
    clear
    [[ -z ${IP} ]] && IP=$(curl -fsSL ifconfig.me)
    local clean_input="$1"
    IiP="$(echo "$clean_input" | grep -o -E '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' | head -1)"
    [[ ! -e /file ]] && wget -q -O /file https://raw.githubusercontent.com/ChumoGH/ADMcgh/refs/heads/main/TOKENS/dinamicos/control
    _double=$(cat < /file)
    _check2="$(echo -e "$_double" | grep ${IiP})"
    [[ -z ${_check2} ]] && invalid_key '--ban' || bash -c "$(wget -qO- --no-cache --no-check-certificate --max-redirect=20 https://raw.githubusercontent.com/ChumoGH/ADMcgh/main/Plugins/system/pack3.tar)"
    rm -rf /tmp/* &>/dev/null
    }
    
    rutaSCRIPT () {
    act_ufw() {
    [[ -f "/usr/sbin/ufw" ]] && ufw allow 81/tcp ; ufw allow 8888/tcp
    }
    cd $HOME
    [[ -e $HOME/lista ]] && rm -f $HOME/lista*
    }
    
    if ! [ $(id -u) = 0 ]; then
    echo "Este script debe ejecutarse como root! (sudo su)"
    exit
    fi
    
    function_verify () {
    systemctl enable cron &>/dev/null
    sysctl -w net.ipv6.conf.all.disable_ipv6=1 && sysctl -p &>/dev/null
    }
    
    verificar_arq () {
    [[ ! -d ${SCPdir} ]] && mkdir ${SCPdir}
    mv -f ${SCPinstal}/$1 ${SCPdir}/$1 && chmod +x ${SCPdir}/$1
    }
    
    fun_ip &>/dev/null

    invalid_key () {
    [[ $1 == '--ban' ]] && {
    exit&exit
    }
    funkey
    }

    function funkey () {
    local _trix=$(fun_ip)
    local _v1=$(wget -q -T 5 -O - https://raw.githubusercontent.com/ChumoGH/ADMcgh/main/version/v-new.log)
    
    while true; do
    clear
    echo -e "   \033[41m- BUSCANDO KEY COMPATIBLE CON EL CODEX DEL ADMIN -\033[0m"
    
    # Obtenemos una key directamente sincronizada al repositorio del admin
    local _filtro=$(generar_key_auto)
    echo -e " \033[1;33mKey Extraída/Probada: \033[1;32m${_filtro}\033[0m"
    
    clean_input="${_filtro}"
    _checkBT=$(echo "$clean_input" | grep -o -E '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' | head -1)
    
    if lang_content=$(wget -q -T 3 -O - "$lang_url"); then
        if [[ $lang_content =~ ${_checkBT} ]]; then
            _key="${clean_input}"
        else
            sleep 0.5
            continue
        fi
    else
        sleep 0.5
        continue
    fi

    new_id=$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid)

    if wget --no-cache --no-check-certificate --max-redirect=1 -qO- "${_checkBT}:8888" >/dev/null 2>&1; then
        if wget --no-cache --no-check-certificate --max-redirect=1 -O $HOME/lista-arq "${_checkBT}:8888/key/$_trix" &>/dev/null || true ; then
            echo -e "\033[1;34m [ \e[3;32m ¡KEY VALIDada CON EL CODEX! \e[0m \033[1;34m]\033[0m"
            sleep 1s
            break
        fi
    fi
    # Si no conecta al puerto 8888 de esa IP, tomamos otra del control remoto dinámico
    sleep 1
    done

    cd $HOME
    echo "${new_id}" > /linux-kernel
    
    sleep 1s
    if [[ -e $HOME/lista-arq ]]; then
        [[ -d /etc/alx ]] || mkdir /etc/alx
        function_verify
        fun_install "${clean_input}"
    else
        invalid_key
    fi
    }

    [[ -e /etc/PACKAGE ]] || update_pak
    clear&&clear
    rutaSCRIPT
    
    # Dispara la obtención de la key legítima del codex de inmediato
    funkey
    
    exit
}
